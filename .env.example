DB_HOST=<db_host>
DB_PORT=<db_port>
DB_READONLY_USER=<readonly_user>
DB_READONLY_PASSWORD=<readonly_password>

# Access control allowlists (comma-separated lists)
# UNIFORM RULE for all three (databases, schemas, tables):
# - If empty, not declared, or '*', all are allowed (unrestricted access).
# - If specified, access is strictly limited to the listed items.
ALLOWED_DATABASES=db_despesas
ALLOWED_SCHEMAS=public
ALLOWED_TABLES=

# Convenience aliases (can be used interchangeably with ALLOWED_*)
database=db_despesas
schema=public
tables=